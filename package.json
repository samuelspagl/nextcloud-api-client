{
  "name": "@samuelspagl/nc-api-client",
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "version": "0.0.1-alpha-19",
  "description": "A simple API client for Nextcloud Apps.",
  "dependencies": {
    "@types/node": "^22.10.2",
    "ofetch": "^1.4.1"
  },
  "exports": {
