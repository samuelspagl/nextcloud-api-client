      "require": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run unbuild",
    "prepack": "bun run unbuild"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelspagl/nextcloud-api-client"
  },
  "keywords": [
    "Nextcloud",
    "API",
    "client",
    "typescript",
    "bookmarks",
    "deck"
  ],
  "author": "Samuel Spagl",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "bun-plugin-dts": "^0.3.0",
    "unbuild": "^3.0.1",
    "@types/bun": "latest"
  },
  "private": true,
  "peerDependencies": {
    "typescript": "^5"
  }
}
