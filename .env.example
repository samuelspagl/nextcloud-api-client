# Nextcloud Server Configuration
NC_SERVER=https://your-nextcloud-instance.com

# Primary Test Account
NC_USER=your-username
NC_PASSWORD=your-app-password

# Secondary Test Account (for multi-user tests)
NC_USER2=your-second-username
NC_PASSWORD2=your-second-app-password

# Test Data IDs
BOOKMARK_ID_IMAGE=123

# OAuth Configuration (if using OAuth client)
NC_CLIENT_ID=your-oauth-client-id
NC_CLIENT_SECRET=your-oauth-client-secret